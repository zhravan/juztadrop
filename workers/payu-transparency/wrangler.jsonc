{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "payu-transparency",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "secrets": {
    "required": [
      "PAYU_MERCHANT_KEY",
      "PAYU_MERCHANT_SALT"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "persist": true
    }
  }
}
